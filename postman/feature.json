              "raw": "{\r\n  \"annotation\": \"Тестовое событие для комментариев\",\r\n  \"description\": \"Описание тестового события для проверки комментариев\",\r\n  \"eventDate\": \"2030-01-01 15:00:00\",\r\n  \"paid\": false,\r\n  \"participantLimit\": 10,\r\n  \"requestModeration\": true,\r\n  \"title\": \"Тестовое событие\",\r\n  \"category\": {{categoryId}},\r\n  \"location\": {\r\n    \"lat\": 55.7558,\r\n    \"lon\": 37.6173\r\n  }\r\n}",
